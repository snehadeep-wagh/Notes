


from langchain_huggingface import ChatHuggingFace, HuggingFacePipeline
import os


# As the C drive has less space, we will keep the main directory for model cache as S drive
os.environ['HF_HOME'] = 'S:/AI/Hugging_Face_Models/hf_model_Cache'


# This line is used to create the local mode instance. The model id needs to be taken from the Hugging Face Website. 
# Then this model will be downloaded locally and can be used.

llm_model = HuggingFacePipeline.from_model_id(
    model_id='TinyLlama/TinyLlama-1.1B-Chat-v1.0',
    task='text-generation',
    pipeline_kwargs=dict(
        temperature=0.9,
        max_new_tokens=100
    )
)


# %pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu126



model = ChatHuggingFace(llm=llm_model)


msg = "Wha is langchain"


res = model.invoke(msg)


res.content



